{
  "name": "node-erp-app",
  "version": "1.0.0",
  "description": "",
  "main": "/src/main.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "start": "node --env-file=.env.pro src/main.js",
    "dev": "node --env-file=.env.dev --watch src/main.js",
    "test:watch": "vitest",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "k6 run test/load/smoke-test.js",
    "test:load:stress": "k6 run test/load/stress-test.js",
    "db:migrate": "node --env-file=.env.dev scripts/migrate.js"
  },
  "keywords": [],
  "type": "module",
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "mysql2": "^3.24.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vitest": "^5.0.0"
  }
}
